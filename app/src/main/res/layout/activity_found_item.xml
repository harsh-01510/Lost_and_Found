<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REPORT FOUND ITEM"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtItemNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="35dp"
            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/edtItemName"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:hint="Enter item name"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/txtItemNameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtDescriptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/edtItemName"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="0dp"
            android:layout_height="65dp"
            android:hint="Enter description"
            android:gravity="top"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/txtDescriptionLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtLocationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Found Location"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/edtDescription"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/edtLocation"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:hint="Where did you find it?"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/txtLocationLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtContactLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contact Number"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/edtLocation"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/edtContact"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:hint="Enter contact number"
            android:inputType="phone"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/txtContactLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PHOTO PREVIEW -->

        <ImageView
            android:id="@+id/imgItem"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            android:background="#D1D5DB"
            android:scaleType="centerCrop"
            android:contentDescription="Found Item Photo"
            android:src="@drawable/ic_launcher_background"
            app:layout_constraintTop_toBottomOf="@id/edtContact"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ADD PHOTO BUTTON -->

        <Button
            android:id="@+id/btnAddPhoto"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="📷 ADD PHOTO "
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/imgItem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- SUBMIT -->

        <Button
            android:id="@+id/btnSubmitFound"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:text="SUBMIT FOUND ITEM"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnAddPhoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>